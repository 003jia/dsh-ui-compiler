  "children": [
    {
      "type": "frame",
      "id": "n110",
      "name": "DSH 设置组件",
      "x": 0,
      "y": 0,
      "width": 820,
      "height": 200,
      "layout": "vertical",
      "gap": 12,
      "padding": 24,
