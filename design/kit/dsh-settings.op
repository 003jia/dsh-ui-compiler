      "children": [
        {
          "type": "text",
          "id": "n111",
          "name": "_libraryTitle",
          "width": "fit_content",
          "height": "fit_content",
          "content": "组件定义与实例",
          "fontFamily": "Inter, system-ui, sans-serif",
          "fontSize": 16,
          "fontWeight": 500,
          "lineHeight": 1.5,
          "fill": [
            {
              "type": "solid",
              "color": "$dsw.alias.label.primary"
            }
          ]
        },
        {
          "type": "text",
          "id": "n112",
          "name": "_libraryNote",
          "width": "fill_container",
          "height": "fit_content",
          "content": "ref 实例引用主组件；variant/size/checked/disabled 编码在名称中。实例名 refresh 对应 onRefresh。",
